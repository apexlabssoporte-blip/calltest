# Application Environment
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
LOG_LEVEL=info
CORS_ORIGIN=*

# PostgreSQL Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/calltest_dev?schema=public"

# Redis
REDIS_URL="redis://localhost:6379/0"

# JWT & Authentication Secrets
JWT_SECRET=development_jwt_secret_must_be_at_least_32_characters_long
REFRESH_TOKEN_SECRET=development_refresh_secret_must_be_at_least_32_chars

# Internal Service HMAC Security
INTERNAL_SERVICE_KEY=calltest-internal-secure-service-key-v1
INTERNAL_SERVICE_SECRET=calltest-internal-secure-service-secret-v1
INTERNAL_SERVICE_SIGNATURE_WINDOW_SECONDS=300

# Campaign Health & Matching Defaults
CAMPAIGN_TARGET_TESTERS=12
CAMPAIGN_MAX_TESTERS=15
CAMPAIGN_DURATION_DAYS=14

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_TIME_WINDOW_MS=60000

# Rewards
REWARD_XP_MISSION_VALIDATED=10
REWARD_GOLD_MISSION_VALIDATED=2
REWARD_XP_FEEDBACK_SUBMITTED=5
REWARD_GOLD_FEEDBACK_SUBMITTED=1
REWARD_XP_PARTICIPATION_COMPLETED=25
REWARD_GOLD_PARTICIPATION_COMPLETED=5
REWARD_XP_CAMPAIGN_COMPLETED=25
REWARD_GOLD_CAMPAIGN_COMPLETED=5

# Evidence Storage
EVIDENCE_STORAGE_PROVIDER=local
# Required when EVIDENCE_STORAGE_PROVIDER=s3 (AWS S3, Cloudflare R2 or MinIO)
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Phase 12 & 12.1: Gemini AI & Escalation Hardening
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
AI_ENABLED=false
AI_DAILY_LIMIT=100
AI_MONTHLY_LIMIT=2000
AI_MAX_REQUESTS_PER_DEVELOPER_PER_DAY=20
AI_CLUSTER_COOLDOWN_HOURS=24
AI_MAX_EVIDENCE_ITEMS_PER_REVIEW=5
AI_MAX_REPORTS_PER_CLUSTER_FOR_AI=10
REPORT_AI_TIMEOUT_MS=5000

