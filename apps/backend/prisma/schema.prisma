  appId                String            @db.Uuid
  campaignId           String            @db.Uuid
  testerId             String            @db.Uuid
  rating               Int
  comment              String
  usefulnessScore      Int               @default(0)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  // Relations
  app                  App               @relation(fields: [appId], references: [id], onDelete: Restrict)
  campaign             Campaign          @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  tester               User              @relation("UserFeedbacks", fields: [testerId], references: [id], onDelete: Restrict)

  @@index([appId])
  @@index([campaignId])
  @@index([testerId])
  @@map("feedbacks")
}

model BugReport {
  id                   String            @id @default(uuid()) @db.Uuid
  appId                String            @db.Uuid
  campaignId           String            @db.Uuid
  testerId             String            @db.Uuid
  title                String
  description          String
  stepsToReproduce     String
  deviceModel          String?
  osVersion            String?
  logs                 String?
  isValidated          Boolean           @default(false)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  // Relations
  app                  App               @relation(fields: [appId], references: [id], onDelete: Restrict)
  campaign             Campaign          @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  tester               User              @relation("UserBugReports", fields: [testerId], references: [id], onDelete: Restrict)

  @@index([appId])
  @@index([campaignId])
