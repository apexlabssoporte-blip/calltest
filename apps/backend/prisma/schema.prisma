// -----------------------------------------------------------------------------
// ENTITIES
// -----------------------------------------------------------------------------

model User {
  id                     String                  @id @default(uuid()) @db.Uuid
  email                  String                  @unique
  passwordHash           String
  displayName            String
  name                   String?
  role                   UserRole                @default(TESTER)
  status                 UserStatus              @default(ACTIVE)
  lastLoginAt            DateTime?
  trustScore             Int                     @default(50)
  rank                   TrustRank               @default(NEW)
  xpBalance              Int                     @default(0)
  goldBalance            Int                     @default(0)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  // Relations
  developerApps          App[]                   @relation("DeveloperApps")
  testerAssignments      CampaignTester[]        @relation("TesterAssignments")
  refreshTokens          RefreshToken[]
  exposureProfile        TesterExposureProfile?
  trustProfile           TrustProfile?
  trustHistories         TrustHistory[]          @relation("UserTrustHistories")
  trustPenalties         TrustPenalty[]          @relation("UserTrustPenalties")
  fraudEvents            FraudEvent[]            @relation("UserFraudEvents")
  missionAttempts        MissionAttempt[]        @relation("UserMissionAttempts")
  activityEvents         ActivityEvent[]         @relation("UserActivityEvents")
  feedbacks              Feedback[]              @relation("UserFeedbacks")
  bugReports             BugReport[]             @relation("UserBugReports")
  rewards                Reward[]                @relation("UserRewards")
  notifications          Notification[]          @relation("UserNotifications")
  notificationPreference NotificationPreference?
  devicePushTokens       DevicePushToken[]       @relation("UserDevicePushTokens")
  auditLogs              AuditLog[]              @relation("UserAuditLogs")
  installationRecords    InstallationRecord[]    @relation("TesterInstallationRecords")
  submittedEvidences     MissionEvidence[]       @relation("TesterMissionEvidences")
  reviewedEvidences      MissionEvidence[]       @relation("DeveloperReviewedEvidences")
  testerReports          TesterReport[]          @relation("TesterReports")
  developerReports       TesterReport[]          @relation("DeveloperReviewedReports")

  @@index([email])
  @@index([role])
  @@index([status])
  @@index([rank])
  @@index([trustScore])
  @@map("users")
}

model Notification {
  id                 String               @id @default(uuid()) @db.Uuid
  userId             String               @db.Uuid
  type               NotificationType
  title              String
  body               String
  data               Json?
  status             NotificationStatus   @default(PENDING)
  priority           NotificationPriority @default(NORMAL)
  channel            NotificationChannel  @default(IN_APP)
  provider           String?              @default("in_app")
  providerMessageId  String?
  deduplicationKey   String?              @unique
  readAt             DateTime?
  scheduledAt        DateTime?
  sentAt             DateTime?
  failedAt           DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  user               User                 @relation("UserNotifications", fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([status])
  @@index([type])
  @@index([createdAt])
  @@map("notifications")
}

model NotificationPreference {
  id                    String   @id @default(uuid()) @db.Uuid
  userId                String   @unique @db.Uuid
  campaignNotifications Boolean  @default(true)
  missionNotifications  Boolean  @default(true)
  trustNotifications    Boolean  @default(true)
  systemNotifications   Boolean  @default(true)
  pushNotifications     Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("notification_preferences")
}

model DevicePushToken {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  token       String    @unique
  platform    String    @default("android")
  isActive    Boolean   @default(true)
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User      @relation("UserDevicePushTokens", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("device_push_tokens")
}

model TrustProfile {
  id                         String            @id @default(uuid()) @db.Uuid
  userId                     String            @unique @db.Uuid
  trustScore                 Int               @default(50)
  trustRank                  TrustRank         @default(NEW)
  reputationStatus           ReputationStatus  @default(NORMAL)
  completedCampaignsCount    Int               @default(0)
  abandonedCampaignsCount    Int               @default(0)
  consecutiveGoodCampaigns   Int               @default(0)
  createdAt                  DateTime          @default(now())
  updatedAt                  DateTime          @updatedAt

  user                       User              @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([trustRank])
  @@index([reputationStatus])
  @@map("trust_profiles")
}

model TrustHistory {
  id                   String            @id @default(uuid()) @db.Uuid
  userId               String            @db.Uuid
  previousScore        Int
  newScore             Int
  previousRank         TrustRank
  newRank              TrustRank
  eventType            TrustEventType
  reason               String
  sourceId             String?
  metadata             Json?
  createdAt            DateTime          @default(now())

  // Relations
  user                 User              @relation("UserTrustHistories", fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([eventType])
  @@index([createdAt])
  @@map("trust_histories")
}

model TrustPenalty {
  id                   String            @id @default(uuid()) @db.Uuid
  userId               String            @db.Uuid
  type                 TrustPenaltyType
  severity             FraudSeverity     @default(LOW)
  scoreImpact          Int
  reason               String
  sourceId             String?
  idempotencyKey       String?           @unique
  createdAt            DateTime          @default(now())

  // Relations
  user                 User              @relation("UserTrustPenalties", fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([type])
  @@index([createdAt])
  @@map("trust_penalties")
}

model FraudEvent {
  id                   String            @id @default(uuid()) @db.Uuid
  userId               String            @db.Uuid
  type                 FraudEventType
  severity             FraudSeverity     @default(LOW)
  scoreImpact          Int               @default(0)
  reason               String
  sourceId             String?
  idempotencyKey       String?           @unique
  metadata             Json?
  resolvedAt           DateTime?
  createdAt            DateTime          @default(now())

  // Relations
  user                 User              @relation("UserFraudEvents", fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([type])
  @@index([severity])
  @@index([createdAt])
  @@map("fraud_events")
}

model TesterExposureProfile {
  id                       String              @id @default(uuid()) @db.Uuid
  userId                   String              @unique @db.Uuid
  level                    TesterExposureLevel @default(NEW)
  overrideMaxCampaigns     Int?
  completedCampaignsCount  Int                 @default(0)
  abandonedCampaignsCount  Int                 @default(0)
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt

  user                     User                @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([level])
  @@map("tester_exposure_profiles")
}

model RefreshToken {
  id                 String       @id @default(uuid()) @db.Uuid
  userId             String       @db.Uuid
  tokenHash          String       @unique
  expiresAt          DateTime
  createdAt          DateTime     @default(now())
  revokedAt          DateTime?
  replacedByTokenId  String?

  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

model App {
  id                  String               @id @default(uuid()) @db.Uuid
  developerId         String               @db.Uuid
  name                String
  packageName         String
  platform            AppPlatform          @default(ANDROID)
  status              AppStatus            @default(DRAFT)
  hasCallTestSdk      Boolean              @default(false)
  sdkIntegrationStatus SdkIntegrationStatus @default(NOT_CONFIGURED)
  description         String?
  playStoreUrl        String?
  googleGroupUrl      String?
  apiKey              String               @unique
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  // Relations
  developer           User                 @relation("DeveloperApps", fields: [developerId], references: [id], onDelete: Restrict)
  campaigns           Campaign[]
  missions            Mission[]
  activityEvents      ActivityEvent[]
  feedbacks           Feedback[]
  bugReports          BugReport[]
  installationRecords InstallationRecord[]
  testerReports       TesterReport[]
  reportClusters      ReportCluster[]

  @@index([developerId])
  @@index([packageName])
  @@index([status])
  @@index([apiKey])
  @@map("apps")
}

model Campaign {
  id                            String                       @id @default(uuid()) @db.Uuid
  appId                         String                       @db.Uuid
  name                          String
  status                        CampaignStatus               @default(DRAFT)
  targetTesters                 Int                          @default(12)
  maxTesters                    Int                          @default(15)
  durationDays                  Int                          @default(14)
  developerConfirmedLinksTest   Boolean                      @default(false)
  storeValidationStatus         PlayStoreValidationStatus    @default(UNKNOWN)
  groupValidationStatus         GoogleGroupValidationStatus  @default(UNKNOWN)
  lastStoreValidationAt         DateTime?
  lastGroupValidationAt         DateTime?
  publicVerifiedAt              DateTime?
  startsAt                      DateTime?
  endsAt                        DateTime?
  createdAt                     DateTime                     @default(now())
  updatedAt                     DateTime                     @updatedAt

  // Relations
  app                 App                  @relation(fields: [appId], references: [id], onDelete: Restrict)
  campaignTesters     CampaignTester[]
  missions            Mission[]
  feedbacks           Feedback[]
  bugReports          BugReport[]
  auditLogs           AuditLog[]
  installationRecords InstallationRecord[]
  evidences           MissionEvidence[]
  testerReports       TesterReport[]
  reportClusters      ReportCluster[]

  @@index([appId])
  @@index([status])
  @@index([storeValidationStatus])
  @@index([groupValidationStatus])
  @@map("campaigns")
}

model CampaignTester {
  id                   String               @id @default(uuid()) @db.Uuid
  campaignId           String               @db.Uuid
  testerId             String               @db.Uuid
  assignmentType       TesterAssignmentType @default(PRIMARY)
  status               TesterStatus         @default(INVITED)
  activityScore        Float                @default(100.0)
  joinedAt             DateTime             @default(now())
  expectedEndAt        DateTime?
  actualEndAt          DateTime?
  isReplacement        Boolean              @default(false)
  exitReason           String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  // Relations
  campaign             Campaign             @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  tester               User                 @relation("TesterAssignments", fields: [testerId], references: [id], onDelete: Restrict)
  missionAttempts      MissionAttempt[]
  difficultyFeedbacks  MissionDifficultyFeedback[]
  qualityFeedbacks     MissionQualityFeedback[]
  activityEvents       ActivityEvent[]

  @@index([campaignId, testerId])
  @@index([campaignId])
  @@index([testerId])
  @@index([status])
  @@index([assignmentType])
  @@map("campaign_testers")
}

model Mission {
  id                   String            @id @default(uuid()) @db.Uuid
  campaignId           String            @db.Uuid
  appId                String?           @db.Uuid
  title                String
  description          String?
  objective            String
  steps                Json
  difficulty           MissionDifficulty @default(MEDIUM)
  estimatedMinutes     Int               @default(15)
  validationMethod     ValidationMethod  @default(SDK_EVENT)
  requiresEvidence     Boolean           @default(false)
  evidenceInstructions String?
  rewardXp             Int               @default(50)
  rewardGold           Int               @default(10)
  status               MissionStatus     @default(DRAFT)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  // Relations
  campaign             Campaign          @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  app                  App?              @relation(fields: [appId], references: [id], onDelete: SetNull)
  attempts             MissionAttempt[]
  difficultyFeedbacks  MissionDifficultyFeedback[]
  qualityFeedbacks     MissionQualityFeedback[]
  evidences            MissionEvidence[]
  testerReports        TesterReport[]

  @@index([campaignId])
  @@index([status])
  @@index([difficulty])
  @@map("missions")
}

model MissionAttempt {
  id                   String            @id @default(uuid()) @db.Uuid
  missionId            String            @db.Uuid
  campaignTesterId     String            @db.Uuid
  testerId             String            @db.Uuid
  status               AttemptStatus     @default(STARTED)
  attemptCount         Int               @default(1)
  validationStatus     String?
  validatedById        String?           @db.Uuid
  validatedAt          DateTime?
  validationReason     String?
  proofData            Json?
  startedAt            DateTime          @default(now())
  completedAt          DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  // Relations
  mission              Mission           @relation(fields: [missionId], references: [id], onDelete: Restrict)
  campaignTester       CampaignTester    @relation(fields: [campaignTesterId], references: [id], onDelete: Restrict)
  tester               User              @relation("UserMissionAttempts", fields: [testerId], references: [id], onDelete: Restrict)
  evidences            MissionEvidence[]

  @@index([missionId])
  @@index([campaignTesterId])
  @@index([testerId])
  @@index([status])
  @@map("mission_attempts")
}

model MissionEvidence {
  id                   String                  @id @default(uuid()) @db.Uuid
  missionAttemptId     String                  @db.Uuid
  campaignId           String                  @db.Uuid
  testerId             String                  @db.Uuid
  missionId            String                  @db.Uuid
  fileReference        String
  mimeType             String
  fileSize             Int
  sha256               String
  status               EvidenceStatus          @default(PENDING_REVIEW)
  submittedAt          DateTime                @default(now())
  reviewedAt           DateTime?
  reviewedById         String?                 @db.Uuid
  rejectionReason      EvidenceRejectionReason?
  rejectionComment     String?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  // Relations
  missionAttempt       MissionAttempt          @relation(fields: [missionAttemptId], references: [id], onDelete: Cascade)
  campaign             Campaign                @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  tester               User                    @relation("TesterMissionEvidences", fields: [testerId], references: [id], onDelete: Restrict)
  mission              Mission                 @relation(fields: [missionId], references: [id], onDelete: Restrict)
  reviewedBy           User?                   @relation("DeveloperReviewedEvidences", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([missionAttemptId])
  @@index([campaignId])
  @@index([testerId])
  @@index([missionId])
  @@index([sha256])
  @@index([status])
  @@map("mission_evidences")
}

model InstallationRecord {
  id                   String                          @id @default(uuid()) @db.Uuid
  campaignId           String                          @db.Uuid
  appId                String                          @db.Uuid
  testerId             String                          @db.Uuid
  installationId       String?
  status               InstallationStatus              @default(NOT_STARTED)
  verificationMethod   InstallationVerificationMethod  @default(USER_CONFIRMATION)
  firstDetectedAt      DateTime?
  firstOpenedAt        DateTime?
  lastSeenAt           DateTime?
  lastSessionAt        DateTime?
  claimedAt            DateTime?
  verifiedAt           DateTime?
  removedAt            DateTime?
  createdAt            DateTime                        @default(now())
  updatedAt            DateTime                        @updatedAt

  // Relations
  campaign             Campaign                        @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  app                  App                             @relation(fields: [appId], references: [id], onDelete: Restrict)
  tester               User                            @relation("TesterInstallationRecords", fields: [testerId], references: [id], onDelete: Restrict)

  @@unique([campaignId, testerId])
  @@index([campaignId, appId])
  @@index([testerId, appId])
  @@index([status])
  @@map("installation_records")
}

model MissionDifficultyFeedback {
  id                   String            @id @default(uuid()) @db.Uuid
  missionId            String            @db.Uuid
  campaignTesterId     String            @db.Uuid
  rating               MissionDifficulty
  createdAt            DateTime          @default(now())

  mission              Mission           @relation(fields: [missionId], references: [id], onDelete: Restrict)
  campaignTester       CampaignTester    @relation(fields: [campaignTesterId], references: [id], onDelete: Restrict)

  @@unique([missionId, campaignTesterId])
  @@index([missionId])
  @@index([campaignTesterId])
  @@map("mission_difficulty_feedbacks")
}

model MissionQualityFeedback {
  id                   String               @id @default(uuid()) @db.Uuid
  missionId            String               @db.Uuid
  campaignTesterId     String               @db.Uuid
  feedback             MissionQualityRating
  comment              String?
  createdAt            DateTime             @default(now())

  mission              Mission              @relation(fields: [missionId], references: [id], onDelete: Restrict)
  campaignTester       CampaignTester       @relation(fields: [campaignTesterId], references: [id], onDelete: Restrict)

  @@index([missionId])
  @@index([campaignTesterId])
  @@index([feedback])
  @@map("mission_quality_feedbacks")
}

model ActivityEvent {
  id                   String            @id @default(uuid()) @db.Uuid
  appId                String            @db.Uuid
  campaignTesterId     String?           @db.Uuid
  testerId             String            @db.Uuid
  sessionId            String
  eventType            ActivityEventType
  eventPayload         Json?
  deviceInfo           Json?
  clientTimestamp      DateTime
  serverTimestamp      DateTime          @default(now())
  isValid              Boolean           @default(true)
  idempotencyKey       String?           @unique

  // Relations
  app                  App               @relation(fields: [appId], references: [id], onDelete: Restrict)
  tester               User              @relation("UserActivityEvents", fields: [testerId], references: [id], onDelete: Restrict)
  campaignTester       CampaignTester?   @relation(fields: [campaignTesterId], references: [id], onDelete: SetNull)

  @@index([appId])
  @@index([testerId])
  @@index([campaignTesterId])
  @@index([sessionId])
  @@index([eventType])
  @@index([serverTimestamp])
  @@map("activity_events")
}

model SessionRecord {
  sessionId            String            @id
  campaignTesterId     String?           @db.Uuid
  testerId             String            @db.Uuid
  startedAt            DateTime
  endedAt              DateTime?
  durationSeconds      Int?
  source               String?
  isAnomalous          Boolean           @default(false)
  createdAt            DateTime          @default(now())

  @@index([campaignTesterId])
  @@index([testerId])
  @@index([startedAt])
  @@map("session_records")
}

model Feedback {
