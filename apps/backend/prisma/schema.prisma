model Reward {
  id                   String            @id @default(uuid()) @db.Uuid
  userId               String            @db.Uuid
  type                 RewardType
  amount               Int
  source               RewardSource
  sourceId             String
  idempotencyKey       String            @unique
  createdAt            DateTime          @default(now())

  // Relations
  user                 User              @relation("UserRewards", fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, source, sourceId])
  @@index([userId])
  @@index([type])
  @@index([source])
  @@map("rewards")
}

model AuditLog {
  id                   String            @id @default(uuid()) @db.Uuid
  userId               String?           @db.Uuid
  campaignId           String?           @db.Uuid
  action               AuditAction
  entityName           String
  entityId             String
  changes              Json?
  ipAddress            String?
  userAgent            String?
  createdAt            DateTime          @default(now())

  // Relations
  user                 User?             @relation("UserAuditLogs", fields: [userId], references: [id], onDelete: SetNull)
  campaign             Campaign?         @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([campaignId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model TesterReport {
  id                      String                  @id @default(uuid()) @db.Uuid
  campaignId              String                  @db.Uuid
  appId                   String                  @db.Uuid
  testerId                String                  @db.Uuid
  missionId               String?                 @db.Uuid
  clusterId               String?                 @db.Uuid
  title                   String
  description             String
  category                ReportCategory          @default(FUNCTIONAL)
  severity                ReportSeverity          @default(MEDIUM)
  status                  ReportStatus            @default(SUBMITTED)
  developerDecision       DeveloperReportDecision?
  developerDecisionReason String?
  developerId             String?                 @db.Uuid
  evidenceIds             String[]                @default([])
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  resolvedAt              DateTime?

  // Relations
  app                     App                     @relation(fields: [appId], references: [id], onDelete: Restrict)
  campaign                Campaign                @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  tester                  User                    @relation("TesterReports", fields: [testerId], references: [id], onDelete: Restrict)
  developer               User?                   @relation("DeveloperReviewedReports", fields: [developerId], references: [id], onDelete: SetNull)
  mission                 Mission?                @relation(fields: [missionId], references: [id], onDelete: SetNull)
  cluster                 ReportCluster?          @relation(fields: [clusterId], references: [id], onDelete: SetNull)
  aiReviews               AiReview[]

  @@index([appId])
  @@index([campaignId])
  @@index([testerId])
  @@index([clusterId])
  @@index([status])
  @@index([category])
  @@index([severity])
  @@map("tester_reports")
}

model ReportCluster {
  id               String              @id @default(uuid()) @db.Uuid
  campaignId       String              @db.Uuid
  appId            String              @db.Uuid
  fingerprint      String              @unique
  status           ReportClusterStatus @default(OPEN)
  reportCount      Int                 @default(1)
  firstReportedAt  DateTime            @default(now())
  lastReportedAt   DateTime            @default(now())
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  // Relations
  app              App                 @relation(fields: [appId], references: [id], onDelete: Restrict)
  campaign         Campaign            @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  reports          TesterReport[]
  aiReviews        AiReview[]

  @@index([appId])
  @@index([campaignId])
  @@index([fingerprint])
  @@index([status])
  @@map("report_clusters")
}

model AiReview {
  id                   String                 @id @default(uuid()) @db.Uuid
  clusterId            String                 @db.Uuid
  reportId             String?                @db.Uuid
  aiReviewKey          String                 @unique
  provider             String                 @default("google-gemini")
  model                String
  policyVersion        String                 @default("1.0.0")
  classification       AiReportClassification
  confidence           Float
  severityAssessment   ReportSeverity?
  evidenceConsistency String?
  duplicateLikelihood  Float?
  reasoningSummary     String
  recommendedAction    AiRecommendedAction    @default(HUMAN_REVIEW)
  latencyMs            Int                    @default(0)
  success              Boolean                @default(true)
  createdAt            DateTime               @default(now())

  // Relations
  cluster              ReportCluster          @relation(fields: [clusterId], references: [id], onDelete: Restrict)
  report               TesterReport?          @relation(fields: [reportId], references: [id], onDelete: SetNull)

  @@index([clusterId])
  @@index([reportId])
  @@index([aiReviewKey])
  @@index([classification])
  @@map("ai_reviews")
}

