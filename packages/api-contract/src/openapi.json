          "200": { "description": "Campaign details" },
          "403": { "description": "Forbidden - IDOR protection" },
          "404": { "description": "Campaign not found" }
        }
      },
      "patch": {
        "tags": ["Campaigns"],
        "summary": "Update campaign configuration",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Campaign updated" },
          "400": { "description": "Cannot modify completed/cancelled campaign" }
