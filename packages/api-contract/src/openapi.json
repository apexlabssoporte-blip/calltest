      },
      "get": {
        "tags": ["Apps"],
        "summary": "List applications owned by current developer",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "List of applications" }
        }
      }
    },
    "/apps/{id}": {
      "get": {
        "tags": ["Apps"],
        "summary": "Get application details by ID",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "App details" },
          "403": { "description": "Forbidden - IDOR protection" },
          "404": { "description": "App not found" }
        }
      },
      "patch": {
        "tags": ["Apps"],
        "summary": "Update application details",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "App updated successfully" },
          "403": { "description": "Forbidden - IDOR protection" },
          "404": { "description": "App not found" }
        }
      },
      "delete": {
        "tags": ["Apps"],
        "summary": "Archive application (soft delete)",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "App archived successfully" },
          "403": { "description": "Forbidden - IDOR protection" },
          "404": { "description": "App not found" }
