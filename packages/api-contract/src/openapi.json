{
  "openapi": "3.0.3",
  "info": {
    "title": "CallTest API",
    "version": "1.0.0",
    "description": "CallTest V1 Modular Monolith REST API Contract - Phase 8 Installation, Evidence & Participation Verification"
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "paths": {
    "/health/live": {
      "get": {
        "summary": "Liveness Probe",
        "description": "Returns 200 OK if process is alive",
        "responses": {
          "200": { "description": "Process is alive" }
        }
      }
    },
    "/health/ready": {
      "get": {
        "summary": "Readiness Probe",
        "description": "Checks connectivity to PostgreSQL and Redis",
        "responses": {
          "200": { "description": "All infrastructure services are healthy" },
          "503": { "description": "One or more infrastructure services are unhealthy" }
        }
      }
    },
    "/health/startup": {
      "get": {
        "summary": "Startup Probe",
        "description": "Verifies that server initialization and startup routines are complete",
        "responses": {
          "200": { "description": "Server initialization complete and ready to serve" }
        }
      }
    },
    "/auth/register": {
      "post": {
        "tags": ["Auth"],
        "summary": "Register a new user account",
        "responses": {
          "201": { "description": "User created successfully with access and refresh tokens" },
          "400": { "description": "Validation error" },
          "409": { "description": "User already exists" }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": ["Auth"],
        "summary": "Authenticate user and issue tokens",
        "responses": {
          "200": { "description": "Successful authentication" },
          "401": { "description": "Invalid email or password" },
          "403": { "description": "Account suspended or banned" }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "tags": ["Auth"],
        "summary": "Rotate refresh token and issue new access token",
        "responses": {
          "200": { "description": "Token rotated successfully" },
          "401": { "description": "Invalid or revoked refresh token" }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "tags": ["Auth"],
        "summary": "Revoke refresh token and log out",
        "responses": {
          "200": { "description": "Logged out successfully" }
        }
      }
    },
    "/me": {
      "get": {
        "tags": ["Auth"],
        "summary": "Get current authenticated user profile",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Current user profile" },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/apps": {
      "post": {
        "tags": ["Apps"],
        "summary": "Register a new application",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "201": { "description": "App registered successfully" },
          "400": { "description": "Invalid package name format" },
          "409": { "description": "Duplicate active package name for this developer" }
