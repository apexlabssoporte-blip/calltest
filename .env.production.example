# ==============================================================================
# CALLTEST V1 - PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# DO NOT COMMIT ACTUAL PRODUCTION SECRETS TO SOURCE CONTROL
# ==============================================================================

# Application Environment
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
CORS_ORIGIN=https://app.calltest.io,https://admin.calltest.io

# PostgreSQL Connection (Use connection pooling URL in production, e.g. PgBouncer)
DATABASE_URL="postgresql://calltest_prod_user:SECURE_PASSWORD@postgres.internal:5432/calltest_prod?schema=public&connection_limit=20&pool_timeout=10"

# Redis Cache & Rate Limiting
REDIS_URL="redis://:SECURE_REDIS_PASSWORD@redis.internal:6379/0"

# JWT & Authentication Security (Minimum 64-char random hex string)
JWT_SECRET=GENERATE_64_CHAR_RANDOM_HEX_FOR_PRODUCTION_JWT_SECRET
REFRESH_TOKEN_SECRET=GENERATE_64_CHAR_RANDOM_HEX_FOR_PRODUCTION_REFRESH_TOKEN

# Internal Engine Security & HMAC Signing
INTERNAL_SERVICE_KEY=GENERATE_64_CHAR_RANDOM_HEX_FOR_INTERNAL_SERVICE_AUTHENTICATION
INTERNAL_SERVICE_SECRET=GENERATE_64_CHAR_RANDOM_HEX_FOR_HMAC_SIGNATURE_SECRET
INTERNAL_SERVICE_SIGNATURE_WINDOW_SECONDS=300

# Campaign Health & Matching Engine Defaults
CAMPAIGN_TARGET_TESTERS=12
CAMPAIGN_MAX_TESTERS=15
CAMPAIGN_DURATION_DAYS=14

# Rate Limiting Guardrails
RATE_LIMIT_MAX=100
RATE_LIMIT_TIME_WINDOW_MS=60000

# Rewards Engine Progression & Currency Defaults
REWARD_XP_MISSION_VALIDATED=10
REWARD_GOLD_MISSION_VALIDATED=2
REWARD_XP_FEEDBACK_SUBMITTED=5
REWARD_GOLD_FEEDBACK_SUBMITTED=1
REWARD_XP_PARTICIPATION_COMPLETED=25
REWARD_GOLD_PARTICIPATION_COMPLETED=5
REWARD_XP_CAMPAIGN_COMPLETED=25
REWARD_GOLD_CAMPAIGN_COMPLETED=5

# Push Notification Service (Firebase Cloud Messaging / APNs)
FCM_PROJECT_ID=calltest-prod
FCM_PRIVATE_KEY_PATH=/secrets/firebase-service-account.json

# Object Storage for Screenshot Evidences (AWS S3 / Cloudflare R2)
EVIDENCE_STORAGE_PROVIDER=local
EVIDENCE_S3_BUCKET=calltest-prod-evidence
EVIDENCE_S3_REGION=us-east-1

# Phase 12 & 12.1: Google Gemini AI Provider & Escalation Hardening
GEMINI_API_KEY=GENERATE_GOOGLE_GEMINI_API_KEY_FOR_BACKEND
GEMINI_MODEL=gemini-1.5-flash
AI_ENABLED=false
AI_DAILY_LIMIT=100
AI_MONTHLY_LIMIT=2000
AI_MAX_REQUESTS_PER_DEVELOPER_PER_DAY=20
AI_CLUSTER_COOLDOWN_HOURS=24
AI_MAX_EVIDENCE_ITEMS_PER_REVIEW=5
AI_MAX_REPORTS_PER_CLUSTER_FOR_AI=10
REPORT_AI_TIMEOUT_MS=5000


