{
  "name": "calltest-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "CallTest Monorepo - Plataforma de pruebas cerradas para apps Android",
  "engines": {
    "node": ">=20.18.0",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint \"apps/**/*.ts\" \"packages/**/*.ts\"",
    "format": "prettier --write \"**/*.{ts,json,md,yml}\"",
    "test": "npm run test --workspaces --if-present",
    "dev:backend": "npm run dev --workspace=apps/backend",
    "db:generate": "npm run db:generate --workspace=apps/backend",
    "db:migrate": "npm run db:migrate --workspace=apps/backend",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@types/node": "^20.17.6",
    "@typescript-eslint/eslint-plugin": "^8.14.0",
    "@typescript-eslint/parser": "^8.14.0",
    "eslint": "^9.14.0",
    "globals": "^15.12.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
