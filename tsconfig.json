{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "resolveJsonModule": true
  },
  "references": [
    { "path": "./packages/config" },
    { "path": "./packages/shared-types" },
    { "path": "./packages/api-contract" },
    { "path": "./apps/backend" }
  ]
}
